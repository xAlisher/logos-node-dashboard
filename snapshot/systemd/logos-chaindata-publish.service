[Unit]
Description=Publish Logos chaindata fast-sync tarball to the GitHub 'chaindata' release (ui#13)
Documentation=https://github.com/xAlisher/logos-node-dashboard/tree/main/snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# GH_TOKEN (contents:write PAT) for the release upload; gh lives in ~/.local/bin.
# gh-pages pointer push uses the repo SSH deploy key. Tars chain data only (state/db),
# never the sibling keystore, behind a hard security gate.
EnvironmentFile=%h/.config/logos-chaindata.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash %h/logos-node-dashboard/snapshot/chaindata-publish.sh
TimeoutStartSec=600
